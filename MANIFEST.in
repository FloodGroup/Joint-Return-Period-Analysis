include LICENSE mkdocs.yml build_docs.py
recursive-include shared *.py *.md *.css *.js *.json *.woff2 *.woff *.ttf LICENSE
recursive-include GBA *.py *.md *.json *.png *.svg
recursive-include SanF *.py *.md *.json *.png *.svg
recursive-include Tokyo *.py *.md *.json *.png *.svg
global-exclude *.csv *.tsv *.parquet *.xlsx *.xls *.shp *.shx *.dbf *.pyc *.pyd *.dll
prune GBA/site
prune SanF/site
prune Tokyo/site
prune private
prune data
prune outputs
prune tests


